# Copy to .env and replace all example credentials and secrets.
APP_ENV=local
APP_URL=http://localhost/manage-grocery-main/project
APP_PUBLIC_BASE_URL=

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=siaa_app_local
DB_PASSWORD=change-this-local-app-password
DB_NAME_POS=grocery_pos
DB_NAME_HRMS=hrms

SESSION_SECURE=false
ID_CRYPT_KEY=replace-with-at-least-32-random-characters
IP_HASH_SALT=replace-with-a-separate-random-secret

ATTENDANCE_LOCATION_MODE=exact
ATTENDANCE_MAX_ACCURACY_METERS=200
ATTENDANCE_STORE_LATITUDE=14.2919444444
ATTENDANCE_STORE_LONGITUDE=120.9586111111
ATTENDANCE_GEOFENCE_RADIUS_METERS=500

BACKUP_DB_USERNAME=siaa_backup_local
BACKUP_DB_PASSWORD=change-this-local-backup-password
MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
BACKUP_DIR=C:\xampp\private\siaa-backups
BACKUP_RETENTION_DAYS=14
APPLICANT_REJECTED_RETENTION_DAYS=365

# Email is required for POS/HRMS verification codes, password resets, and
# workflow notices. For Gmail, enable 2-Step Verification and create an App
# Password at https://myaccount.google.com/apppasswords. Do not use your normal
# Gmail password. Set SMTP_FROM_EMAIL to the authenticated Gmail address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Optional display name for outgoing messages.
SMTP_FROM_NAME=Manage Grocery System
PASSWORD_RESET_URL=
PUBLIC_DB_NAME=grocery_pos
PUBLIC_DB_USERNAME=
PUBLIC_DB_PASSWORD=
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# To use Groq, set AI_PROVIDER=groq, put the key in GROQ_API_KEY, and leave
# OPENAI_BASE_URL blank (Groq's OpenAI-compatible URL is selected by default).
GROQ_API_KEY=
TAVILY_API_KEY=
