# Copy to .env on the production host and replace every placeholder.
APP_ENV=production
APP_URL=https://pos.example.com
APP_PUBLIC_BASE_URL=https://pos.example.com

DB_HOST=localhost
DB_USERNAME=siaa_app
DB_PASSWORD=replace-with-a-unique-database-password
DB_NAME_POS=grocery_pos
DB_NAME_HRMS=hrms

SESSION_SECURE=true
ID_CRYPT_KEY=replace-with-at-least-32-random-characters
IP_HASH_SALT=replace-with-a-separate-random-secret

ATTENDANCE_LOCATION_MODE=exact
ATTENDANCE_MAX_ACCURACY_METERS=200
ATTENDANCE_STORE_LATITUDE=14.2919444444
ATTENDANCE_STORE_LONGITUDE=120.9586111111
ATTENDANCE_GEOFENCE_RADIUS_METERS=500

BACKUP_DB_USERNAME=siaa_backup
BACKUP_DB_PASSWORD=replace-with-a-separate-backup-password
MYSQLDUMP_PATH=/usr/bin/mysqldump
BACKUP_DIR=/var/backups/siaa
BACKUP_RETENTION_DAYS=14
APPLICANT_REJECTED_RETENTION_DAYS=365

# Optional integrations. Leave blank until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
PASSWORD_RESET_URL=
PUBLIC_DB_NAME=grocery_pos
PUBLIC_DB_USERNAME=
PUBLIC_DB_PASSWORD=
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
TAVILY_API_KEY=
