APP_NAME=GroceryOne
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost/manage-grocery-main/public
APP_TIMEZONE=Asia/Manila

DB_CONNECTION=pos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME_POS=grocery_pos
DB_NAME_HRMS=hrms
DB_USERNAME=replace_with_scoped_web_account
DB_PASSWORD=replace_with_private_password

SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_COOKIE=groceryone_laravel_session
SESSION_PATH=/manage-grocery-main/public
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=warning

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=GroceryOne

# Keep legacy project/.env separate. Never use root credentials for the web app.
# Synthetic tests require a separate private .env.testing, two empty marked
# groceryone_test_<10-lowercase-hex>_<pos|hrms> databases, scoped credentials,
# APP_ENV=testing, MAIL_MAILER=array and TEST_TARGET_NONCE matching both markers.
# GROCERY_SCHEMA_ADOPTION is reserved for the private migration environment.